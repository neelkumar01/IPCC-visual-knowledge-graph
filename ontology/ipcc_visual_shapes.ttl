@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ipcc: <https://neelkumar01.github.io/IPCC-visual-knowledge-graph/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ipcc:AssessmentReportShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass ipcc:AssessmentReport .

ipcc:CaptionMentionShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:in ( "lexical" "explicit_expansion" "chemical_formula" ) ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path ipcc:resolution ],
                    [ sh:class ipcc:ScientificConcept ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path ipcc:denotesConcept ] ] [ sh:property [ sh:maxCount 0 ;
                        sh:path ipcc:denotesConcept ],
                    [ sh:in ( "ambiguous" "excluded" ) ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path ipcc:resolution ] ] ) ;
    sh:property [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:startOffset ],
        [ sh:datatype xsd:string ;
            sh:in ( "lexical" "explicit_expansion" "chemical_formula" "ambiguous" "excluded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:resolution ],
        [ sh:class ipcc:Figure ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:mentionInFigure ],
        [ sh:class ipcc:ScientificConcept ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:denotesConcept ],
        [ sh:class ipcc:ScientificConcept ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:candidateConcept ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:endOffset ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:matchedText ],
        [ sh:datatype xsd:string ;
            sh:in ( "label" "alias" "mixed" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:matchKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ipcc:qualityRule ] ;
    sh:targetClass ipcc:CaptionMention .

ipcc:FigureShape a sh:NodeShape ;
    sh:property [ sh:class ipcc:CaptionMention ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:hasCaptionMention ],
        [ sh:class ipcc:ImageReference ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:hasImageReference ],
        [ sh:datatype xsd:string ;
            sh:in ( "available" "missing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:captionStatus ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ipcc:captionText ],
        [ sh:class ipcc:ScientificConcept ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:mentionsConcept ],
        [ sh:class ipcc:WorkingGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:figureInWorkingGroup ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ipcc:captionSHA256 ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:class ipcc:ReportSection ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:figureInSection ] ;
    sh:targetClass ipcc:Figure .

ipcc:ImageReferenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:imagePosition ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:imageURL ] ;
    sh:targetClass ipcc:ImageReference .

ipcc:ReportSectionShape a sh:NodeShape ;
    sh:property [ sh:class ipcc:WorkingGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:sectionOfWorkingGroup ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:sectionCode ] ;
    sh:targetClass ipcc:ReportSection .

ipcc:ScientificConceptShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path skos:prefLabel ],
        [ sh:class ipcc:WorkingGroup ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:glossaryWorkingGroup ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass ipcc:ScientificConcept .

ipcc:WorkingGroupShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "WG1" "WG2" "WG3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ipcc:workingGroupCode ],
        [ sh:class ipcc:AssessmentReport ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path ipcc:partOfReport ] ;
    sh:targetClass ipcc:WorkingGroup .

